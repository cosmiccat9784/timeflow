{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TimeFlow",
  "version": "0.1.0",
  "identifier": "com.timeflow.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "TimeFlow",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "category": "Productivity",
    "shortDescription": "Visual weekly timetable planner",
    "longDescription": "TimeFlow makes it easy to plan, organise, switch between, and review activities in a repeating weekly timetable.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
